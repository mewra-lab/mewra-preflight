{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Mewra PreFlight Configuration",
  "description": "Configuration schema for Mewra PreFlight pre-push pipeline (.mewra-preflight.json)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Schema URI for autocompletion and validation"
    },
    "targetBranch": {
      "type": "string",
      "description": "Default target git branch to diff against (e.g. main, develop, master)",
      "default": "main"
    },
    "universalChecks": {
      "type": "object",
      "description": "Configuration for universal language-agnostic sanity checks",
      "properties": {
        "noDebugStatements": {
          "type": "string",
          "enum": ["error", "warning", "off"],
          "description": "Severity for console.log and debugger statements",
          "default": "error"
        },
        "noSecrets": {
          "type": "string",
          "enum": ["error", "warning", "off"],
          "description": "Severity for leaked API keys, tokens, or .env secrets",
          "default": "error"
        },
        "noLocalhostUrls": {
          "type": "string",
          "enum": ["error", "warning", "off"],
          "description": "Severity for hardcoded localhost/127.0.0.1 URLs",
          "default": "error"
        },
        "noMergeConflicts": {
          "type": "string",
          "enum": ["error", "warning", "off"],
          "description": "Severity for unresolved git merge conflict markers",
          "default": "error"
        },
        "largeFileThresholdMb": {
          "type": "number",
          "description": "Threshold in MB for flagging large newly added files (set to 0 to disable)",
          "default": 1,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "manualChecklist": {
      "type": "array",
      "description": "Custom manual checklist items displayed before push & PR creation. Press Ctrl+Space to insert a template.",
      "defaultSnippets": [
        {
          "label": "Manual Check (Conditional)",
          "description": "Add a manual verification item triggered when matching files are modified",
          "body": [
            {
              "id": "${1:db-migration}",
              "label": "${2:Did you apply database migration to dev DB?}",
              "severity": "${3|error,warning|}",
              "condition": {
                "modifiedFilesMatch": "${4:prisma/migrations/**}"
              }
            }
          ]
        },
        {
          "label": "Manual Check (Always Active)",
          "description": "Add a manual verification item shown on every PR",
          "body": [
            {
              "id": "${1:check-id}",
              "label": "${2:Verification task description}",
              "severity": "${3|warning,error|}"
            }
          ]
        }
      ],
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "defaultSnippets": [
          {
            "label": "Manual Check (Conditional)",
            "description": "Triggered when files matching glob pattern are modified",
            "body": {
              "id": "${1:db-migration}",
              "label": "${2:Did you apply database migration to dev DB?}",
              "severity": "${3|error,warning|}",
              "condition": {
                "modifiedFilesMatch": "${4:prisma/migrations/**}"
              }
            }
          },
          {
            "label": "Manual Check (Always Active)",
            "description": "Always displayed on every PR",
            "body": {
              "id": "${1:check-id}",
              "label": "${2:Verification task description}",
              "severity": "${3|warning,error|}"
            }
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for this manual check"
          },
          "label": {
            "type": "string",
            "description": "Human-readable label / question displayed in dashboard"
          },
          "severity": {
            "type": "string",
            "enum": ["error", "warning"],
            "default": "error",
            "description": "Severity level. 'error' blocks push until checked; 'warning' displays a notice"
          },
          "agentCheckable": {
            "type": "boolean",
            "default": false,
            "description": "Allow an enabled MCP agent to mark this item after it independently verifies the condition"
          },
          "condition": {
            "type": "object",
            "description": "Optional condition determining when this check triggers",
            "properties": {
              "modifiedFilesMatch": {
                "type": "string",
                "description": "Glob pattern matching changed files to trigger this check (e.g. 'prisma/migrations/**')"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "mcp": {
      "type": "object",
      "description": "Controls the local Mewra PreFlight MCP server.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "exposedTools": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "get_preflight_status",
              "get_check_findings",
              "run_check",
              "mark_manual_check"
            ]
          },
          "uniqueItems": true
        },
        "agentCheckableManualChecks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "ecosystems": {
      "type": "object",
      "description": "Configuration for ecosystem-specific check packs (e.g. js-ts, go, python)",
      "properties": {
        "js-ts": {
          "type": "object",
          "description": "JavaScript / TypeScript ecosystem settings",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "format": {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string",
                  "default": "prettier",
                  "enum": ["prettier"]
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600000,
                  "description": "Timeout per CLI invocation in milliseconds (default 30000)."
                }
              },
              "additionalProperties": false
            },
            "lint": {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string",
                  "default": "eslint",
                  "enum": ["eslint"]
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600000,
                  "description": "Timeout per CLI invocation in milliseconds (default 30000)."
                }
              },
              "additionalProperties": false
            },
            "typecheck": {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string",
                  "default": "tsc",
                  "enum": ["tsc", "vue-tsc"]
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600000,
                  "description": "Timeout per CLI invocation in milliseconds (default 30000)."
                }
              },
              "additionalProperties": false
            },
            "testPairing": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "pattern": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Simple source-path glob (* and **); extglobs are not supported."
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600000,
                  "description": "Timeout per CLI invocation in milliseconds (default 30000)."
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "go": {
          "type": "object",
          "description": "Go ecosystem settings",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "format": {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string",
                  "default": "gofmt",
                  "enum": ["gofmt"]
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600000,
                  "description": "Timeout per CLI invocation in milliseconds (default 30000)."
                }
              },
              "additionalProperties": false
            },
            "vet": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600000,
                  "description": "Timeout per CLI invocation in milliseconds (default 30000)."
                }
              },
              "additionalProperties": false
            },
            "lint": {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string",
                  "default": "golangci-lint",
                  "enum": ["golangci-lint"]
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600000,
                  "description": "Timeout per CLI invocation in milliseconds (default 30000)."
                }
              },
              "additionalProperties": false
            },
            "testPairing": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600000,
                  "description": "Timeout per CLI invocation in milliseconds (default 30000)."
                },
                "pattern": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Simple source-path glob (* and **); extglobs are not supported."
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "python": {
          "type": "object",
          "description": "Python ecosystem settings (supports uv, ruff, black, mypy)",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "format": {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string",
                  "enum": ["ruff", "black"],
                  "default": "ruff"
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600000,
                  "description": "Timeout per CLI invocation in milliseconds (default 30000)."
                }
              },
              "additionalProperties": false
            },
            "lint": {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string",
                  "enum": ["ruff", "flake8"],
                  "default": "ruff"
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600000,
                  "description": "Timeout per CLI invocation in milliseconds (default 30000)."
                }
              },
              "additionalProperties": false
            },
            "typecheck": {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string",
                  "default": "mypy",
                  "enum": ["mypy"]
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600000,
                  "description": "Timeout per CLI invocation in milliseconds (default 30000)."
                }
              },
              "additionalProperties": false
            },
            "testPairing": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600000,
                  "description": "Timeout per CLI invocation in milliseconds (default 30000)."
                },
                "pattern": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Simple source-path glob (* and **); extglobs are not supported."
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "php": {
          "type": "object",
          "description": "PHP ecosystem settings",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "format": {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string",
                  "default": "php-cs-fixer",
                  "enum": ["php-cs-fixer"]
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600000,
                  "description": "Timeout per CLI invocation in milliseconds (default 30000)."
                }
              },
              "additionalProperties": false
            },
            "analyze": {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string",
                  "enum": ["phpstan", "psalm"],
                  "default": "phpstan"
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600000,
                  "description": "Timeout per CLI invocation in milliseconds (default 30000)."
                }
              },
              "additionalProperties": false
            },
            "testPairing": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600000,
                  "description": "Timeout per CLI invocation in milliseconds (default 30000)."
                },
                "pattern": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Simple source-path glob (* and **); extglobs are not supported."
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "orm-cost-sentry": {
          "type": "object",
          "description": "Diff-scoped ORM query cost and destructive migration heuristics",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false
        },
        "style-guardian": {
          "type": "object",
          "description": "Diff-scoped template style consistency checks",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "contributedChecks": {
      "type": "object",
      "description": "Enable or override severity for checks registered by installed extensions",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "severity": {
            "type": "string",
            "enum": ["error", "warning"]
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600000,
            "description": "Timeout per CLI invocation in milliseconds (default 30000)."
          }
        },
        "additionalProperties": false
      }
    },
    "customPacks": {
      "type": "array",
      "description": "Custom community check packs (no-code tool registration)",
      "defaultSnippets": [
        {
          "label": "Custom Pack (e.g. Rust, Ruby, Shell)",
          "description": "Define a custom ecosystem pack with checks",
          "body": [
            {
              "id": "${1:rust}",
              "label": "${2:Rust}",
              "ecosystemMarker": "${3:Cargo.toml}",
              "checks": [
                {
                  "id": "${1:rust}:${4:fmt}",
                  "label": "${5:Cargo Fmt}",
                  "tool": "${6:cargo}",
                  "args": ["fmt", "--check", "--"],
                  "appendChangedFiles": true,
                  "fileExtensions": [".rs"],
                  "severity": "error",
                  "fixArgs": ["fmt", "--"]
                }
              ]
            }
          ]
        }
      ],
      "items": {
        "type": "object",
        "required": ["id", "label", "checks"],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "ecosystemMarker": {
            "type": "string"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "tool"],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "tool": {
                  "type": "string"
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "appendChangedFiles": {
                  "type": "boolean",
                  "default": true
                },
                "fileExtensions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "filesMatch": {
                  "type": "string"
                },
                "severity": {
                  "type": "string",
                  "enum": ["error", "warning"],
                  "default": "error"
                },
                "fixArgs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600000,
                  "description": "Timeout per CLI invocation in milliseconds (default 30000)."
                },
                "dependsOn": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "pack": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "customChecks": {
      "type": "array",
      "description": "Standalone custom checks (e.g. shellcheck, yamllint)",
      "defaultSnippets": [
        {
          "label": "Custom Check (e.g. ShellCheck, Linter)",
          "description": "Define a standalone CLI check runner",
          "body": [
            {
              "id": "custom:${1:shellcheck}",
              "label": "${2:ShellCheck}",
              "tool": "${3:shellcheck}",
              "args": ["${4:-x}"],
              "appendChangedFiles": true,
              "fileExtensions": ["${5:.sh}"],
              "severity": "${6|warning,error|}"
            }
          ]
        }
      ],
      "items": {
        "type": "object",
        "required": ["id", "label", "tool"],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "appendChangedFiles": {
            "type": "boolean",
            "default": true
          },
          "fileExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "filesMatch": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["error", "warning"],
            "default": "error"
          },
          "fixArgs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600000,
            "description": "Timeout per CLI invocation in milliseconds (default 30000)."
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "pack": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
