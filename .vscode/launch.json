{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Mewra PreFlight (Extension Development Host)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js",
        "${workspaceFolder}/dist/**/*.cjs"
      ],
      "preLaunchTask": "Mewra PreFlight: Build"
    },
    {
      "name": "Run PreFlight + Companions (Extension Development Host)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionDevelopmentPath=${workspaceFolder}/../mewra-dependency-guard",
        "--extensionDevelopmentPath=${workspaceFolder}/../mewra-pounce"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js",
        "${workspaceFolder}/dist/**/*.cjs",
        "${workspaceFolder}/../mewra-dependency-guard/dist/**/*.js",
        "${workspaceFolder}/../mewra-dependency-guard/dist/**/*.cjs",
        "${workspaceFolder}/../mewra-pounce/dist/**/*.js",
        "${workspaceFolder}/../mewra-pounce/dist/**/*.cjs"
      ],
      "preLaunchTask": "Mewra PreFlight + Companions: Build"
    }
  ]
}
